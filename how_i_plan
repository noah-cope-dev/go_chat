        func SendMessage(conn net.Conn, msg Message) error {
            code := msg.GetProtocolCode()
            data, err := msg.Encode()
            if err != nil {
                return err
            }

            // [protocol code byte][encoded data]
            packet := append([]byte{code}, data...)
            _, err = conn.Write(packet)
            return err
            }

