        i
        func (l *LoginRequest) GetProtocolCode() byte {
            return 0x01
        }

        func (l *LoginRequest) Encode() ([]byte, error) {
            return []byte(l.Username + ":" + l.Password), nil
        }

        type ChatMessage struct {
            From string
            Text string
        }

        func (c *ChatMessage) GetProtocolCode() byte {
            return 0x02
        }

        func (c *ChatMessage) Encode() ([]byte, error) {
            return []byte(c.From + ": " + c.Text), nil
        }

