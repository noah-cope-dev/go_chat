        lets talk about that Protocol

        // this is the behavior
        type Protocol interface {
        Decode([]byte) error
        Encode([]byte) error
        }

        type Client(c *Client) struct {
            Name string
        }

        // lets implement it
        func (c *Client) Encode() ([]byte, error) {
            // Client encodes its data to send
            return []byte(c.Name), nil
        }

        func (c *Client) Decode(data []byte) error {
        // Client decodes received data
            c.Name = string(data)
            return nil
        }

        type Server struct {
             Port int
        }


        func (s *Server) Encode() ([]byte, error) {
            // Server encodes its data to send
            return []byte(fmt.Sprintf("%d", s.Port)), nil
        }

        func (s *Server) Decode(data []byte) error {
            // Server decodes received data
            port, _ := strconv.Atoi(string(data))
            s.Port = port
            return nil
        }

        watch this magic

        // look at this basically generic function
        func SendOverTCP(conn net.Conn, p Protocol) error {
                data, err := p.Encode // works for client of the server
                if err != nil {
                    return err
                }
                _,err conn.Write(data)
                return err
        }
        func ReceiveFromTCP(conn net.Conn, p Protocol) error {
        buffer := make([]byte, 1024)
        n, err := conn.Read(buffer)
        if err != nil {
            return err
        }
        return p.Decode(buffer[:n])  // Works for Client OR Server
    }

